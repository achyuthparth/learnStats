        <UserObject label="&lt;h4&gt;&lt;strong&gt;Dataset Partition Table (&lt;/strong&gt;&lt;code&gt;dataset_partition&lt;/code&gt;&lt;strong&gt;)&lt;/strong&gt;&lt;/h4&gt;&lt;div&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;strong&gt;Column Name&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Data Type&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Description&lt;/strong&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;partition_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER PRIMARY KEY&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Unique identifier for the partition entry&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;image_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER NOT NULL&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Foreign key linking to &lt;code&gt;images.id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font face=&quot;monospace&quot;&gt;dataset_split&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT CHECK (dataset_type IN (&#39;train&#39;, &#39;test&#39;, &#39;val&#39;))&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Defines dataset split&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;source_type&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT CHECK (source_type IN (&#39;COCO_standard&#39;, &#39;COCO_construction&#39;, &#39;Generated&#39;, &#39;Web_scraped&#39;))&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Tracks dataset origin&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" link="&lt;h4&gt;&lt;strong&gt;Dataset Partition Table (&lt;/strong&gt;&lt;code&gt;dataset_partition&lt;/code&gt;&lt;strong&gt;)&lt;/strong&gt;&lt;/h4&gt;&lt;div&gt;&lt;div&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;strong&gt;Column Name&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Data Type&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Description&lt;/strong&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;partition_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER PRIMA
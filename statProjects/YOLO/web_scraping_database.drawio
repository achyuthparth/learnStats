        <UserObject label="&lt;h3&gt;&lt;strong&gt;🟢 Image Categorization Table (&lt;/strong&gt;&lt;code&gt;image_category&lt;/code&gt;&lt;strong&gt;)&lt;/strong&gt;&lt;/h3&gt;&lt;div&gt;&lt;div&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;strong&gt;Column Name&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Data Type&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Description&lt;/strong&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;category_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER PRIMARY KEY&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Unique identifier for the category entry&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;image_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER NOT NULL&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Foreign key linking to &lt;code&gt;images.id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;category_name&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT NOT NULL&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Object type (e.g., &lt;code&gt;&quot;crane&quot;, &quot;bulldozer&quot;, &quot;hard_hat&quot;&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;noise_level&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT CHECK (noise_level IN (&#39;low&#39;, &#39;high&#39;, &#39;medium&#39;, NULL))&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Describes image quality/noise level&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;" link="&lt;h3&gt;&lt;strong&gt;🟢 Image Categorization Table (&lt;/strong&gt;&lt;code&gt;image_category&lt;/code&gt;&lt;strong&gt;)&lt;/strong&gt;&lt;/h3&gt;&lt;div&gt;&lt;div&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;strong&gt;Column Name&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Data Type&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Description&lt;/strong&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;category_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER PRIMARY KEY&lt;
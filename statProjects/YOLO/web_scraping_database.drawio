        <mxCell id="r_cjlKP0dEog_J9cwVYJ-6" value="&lt;h3&gt;&lt;strong&gt;🔹 Main Image Table (&lt;/strong&gt;&lt;code&gt;images&lt;/code&gt;&lt;strong&gt;)&lt;/strong&gt;&lt;/h3&gt;&lt;div&gt;&lt;div&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;strong&gt;Column Name&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Data Type&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Description&lt;/strong&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;image_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER PRIMARY KEY&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Unique image identifier&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;image_url&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT UNIQUE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Direct URL if web-scraped&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;file_path&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT UNIQUE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Local file storage path&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;resolution&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Image dimensions (e.g., &quot;1024x768&quot;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;date_collected&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;DATETIME DEFAULT CURRENT_TIMESTAMP&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Timestamp of collection&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="260" width="560" height="210" as="geometry" />
        </mxCell>
        <UserObject label="&lt;h3&gt;&lt;strong&gt;🔹 A&lt;/strong&gt;&lt;code&gt;nnotations&lt;/code&gt;&lt;strong&gt; Table&lt;/strong&gt;&lt;/h3&gt;&lt;div&gt;&lt;div&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;strong&gt;Column Name&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Data Type&lt;/strong&gt;&lt;/th&gt;&lt;th&gt;&lt;strong&gt;Description&lt;/strong&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;annotation_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER PRIMARY KEY&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Unique identifier for each bounding box&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;image_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER NOT NULL&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Foreign key linking to &lt;code&gt;images.id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;bounding_box&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT NOT NULL&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stores coordinates (&lt;code&gt;x, y, width, height&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;category_id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;INTEGER NOT NULL&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Foreign key linking to &lt;code&gt;image_category.category_id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;confidence_score&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;REAL&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Prediction confidence (if automated)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;annotation_source&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;TEXT CHECK (annotation_source IN (&#39;manual&#39;, &#39;automated&#39;))&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Defines if annotation was &lt;strong&gt;manually labeled or AI-generated&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;" link="&lt;h3&gt;&lt;strong&gt;🔹 Updated &lt;/strong&gt;&lt;code&gt;annotations&lt;/code&gt;&lt;strong&gt; Table&lt;/strong&gt;&lt;/h3&gt;&l